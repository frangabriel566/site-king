# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Better Auth
# Secret used to sign sessions and reset tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Canonical origin, used in password-reset links. Optional locally (the
# request's own origin is used); set it in production, e.g.
# https://www.kingstore.com.br
BETTER_AUTH_URL=

# Payments
# "mercadopago" (default) or "whatsapp"
PAYMENT_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail (Resend) — order confirmations and "esqueci minha senha"
RESEND_API_KEY=
RESEND_FROM_EMAIL=King Store <pedidos@kingstore.com.br>

# Shipping (Melhor Envio)
MELHORENVIO_TOKEN=
MELHORENVIO_URL=
MELHORENVIO_EMAIL=

# Database (D1) and images (Workers KV) are Cloudflare bindings declared in
# wrangler.jsonc — no env vars for them.
