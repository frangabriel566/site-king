{
  "name": "king-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply king-store-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply king-store-db --remote",
    "db:seed:local": "wrangler d1 execute king-store-db --local --file=drizzle/seed.sql",
    "db:seed:remote": "wrangler d1 execute king-store-db --remote --file=drizzle/seed.sql",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.38.0",
    "mercadopago": "^3.6.0",
    "next": "15.5.27",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.8.0",
    "resend": "^6.25.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  }
}
