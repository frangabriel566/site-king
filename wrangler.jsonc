{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "site-king",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "king-store-db",
			"database_id": "60cbc00b-3dbf-455f-9a80-b9d0e6dff56b",
			// Generated by drizzle-kit from lib/db/schema.ts (npm run db:generate)
			"migrations_dir": "drizzle/migrations"
		}
	],
	"kv_namespaces": [
		{
			// Product, banner and brand photos (lib/storage.ts). Temporary home
			// until R2 is enabled — swapping it only touches lib/storage.ts.
			"binding": "IMAGES_KV",
			"id": "cc3bd0be9126487a9c0ab0a44b00aac1"
		}
	],
	// Workers Logs: per-request CPU time, wall time and errors in the dashboard.
	"observability": {
		"enabled": true
	},
	// Plain-text variables (BETTER_AUTH_URL, PAYMENT_PROVIDER, …) are set in
	// the Cloudflare dashboard, not here. Without this, every deploy would
	// delete them; secrets survive either way.
	"keep_vars": true
}
